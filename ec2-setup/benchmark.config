# Non-secret defaults for the pg_stat_statements EC2 benchmark.

INSTANCE_TYPE=${INSTANCE_TYPE:-c7i.8xlarge}
AMI_SSM_PARAMETER=${AMI_SSM_PARAMETER:-/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64}
VOLUME_SIZE_GB=${VOLUME_SIZE_GB:-200}
VOLUME_TYPE=${VOLUME_TYPE:-gp3}
VOLUME_IOPS=${VOLUME_IOPS:-6000}
VOLUME_THROUGHPUT=${VOLUME_THROUGHPUT:-250}

PG_REMOTE=${PG_REMOTE:-https://github.com/postgres/postgres.git}
PATCH_REMOTE=${PATCH_REMOTE:-https://github.com/samimseih/postgres.git}
PATCH_REF=${PATCH_REF:-pg_stat_statements_custom_kind_dsa_qtext}
PATCH_COMMIT=${PATCH_COMMIT:-}
# More patch commits to benchmark, from PATCH_REMOTE, e.g. the commits under
# PATCH_COMMIT
EXTRA_COMMITS=${EXTRA_COMMITS:-}
BASE_REF=${BASE_REF:-master}
BENCHMARK_REPO=${BENCHMARK_REPO:-https://github.com/samimseih/pg_stat_statements_benchmark.git}

CLIENTS=${CLIENTS:-1 2 4 8 16 32 64 128 256}
SELECT_CLIENTS=${SELECT_CLIENTS:-$CLIENTS}
HOTCOLD_100M_CLIENTS=${HOTCOLD_100M_CLIENTS:-$CLIENTS}
HOTCOLD_1500_CLIENTS=${HOTCOLD_1500_CLIENTS:-$CLIENTS}
HOTCOLD_SECONDS=${HOTCOLD_SECONDS:-300}
SELECT_SECONDS=${SELECT_SECONDS:-300}
RUN_HOTCOLD_4000_100M=${RUN_HOTCOLD_4000_100M:-1}
RUN_HOTCOLD_4000_1500=${RUN_HOTCOLD_4000_1500:-0}
RUN_SELECT_ONLY=${RUN_SELECT_ONLY:-1}
RUN_TRICKLE_5000=${RUN_TRICKLE_5000:-0}
TRICKLE_CLIENTS=${TRICKLE_CLIENTS:-32}
TRICKLE_SECONDS=${TRICKLE_SECONDS:-300}
TRICKLE_RATE=${TRICKLE_RATE:-1}
TRICKLE_RESIDENTS=${TRICKLE_RESIDENTS:-5000}
RUN_ORDER=${RUN_ORDER:-commit_major}
CLIENT_ORDER=${CLIENT_ORDER:-outside_in}
PGSS_SAMPLE_SECONDS=${PGSS_SAMPLE_SECONDS:-10}
PGSS_SAMPLE_START_DELAY_SECONDS=${PGSS_SAMPLE_START_DELAY_SECONDS:-15}
PROGRESS_SECONDS=${PROGRESS_SECONDS:-2}
SELECT_SCALE=${SELECT_SCALE:-100}
PGSS_MAX=${PGSS_MAX:-5000}
PGSS_QUERY_TEXT_MEMORY=${PGSS_QUERY_TEXT_MEMORY:-}
MAX_CONNECTIONS=${MAX_CONNECTIONS:-300}

PROFILE_COMMITS=${PROFILE_COMMITS:-}
PROFILE_CLIENTS=${PROFILE_CLIENTS:-128 256}
PROFILE_SECONDS=${PROFILE_SECONDS:-150}
PROFILE_WARMUP_SECONDS=${PROFILE_WARMUP_SECONDS:-20}
PROFILE_RECORD_SECONDS=${PROFILE_RECORD_SECONDS:-90}

RESULT_BUCKET=${RESULT_BUCKET:-pgss-benchmark-${AWS_ACCOUNT_ID}-${AWS_REGION}}
RESULT_PREFIX=${RESULT_PREFIX:-runs}
# What an instance does when its benchmark is done and uploaded: stop,
# terminate, or none (keep running).  AUTO_TERMINATE=1 means terminate.
# With SHUTDOWN_ON_FAILURE=1, or TERMINATE_ON_FAILURE=1, failed runs shut
# down too instead of staying up for inspection.
AUTO_SHUTDOWN=${AUTO_SHUTDOWN:-stop}
AUTO_TERMINATE=${AUTO_TERMINATE:-0}
SHUTDOWN_ON_FAILURE=${SHUTDOWN_ON_FAILURE:-${TERMINATE_ON_FAILURE:-0}}

INSTANCE_PROFILE_NAME=${INSTANCE_PROFILE_NAME:-pgss-benchmark-ssm-profile}
ROLE_NAME=${ROLE_NAME:-pgss-benchmark-ssm-role}
SECURITY_GROUP_NAME=${SECURITY_GROUP_NAME:-pgss-benchmark-ssm}
ASSOCIATE_PUBLIC_IP=${ASSOCIATE_PUBLIC_IP:-true}
